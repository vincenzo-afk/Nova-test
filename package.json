{
  "name": "nova",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA local-first desktop agent platform",
  "packageManager": "pnpm@9.15.5",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:links": "python3 scripts/check-links.py",
    "format": "prettier --write \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"vitest.config.ts\" \"eslint.config.mjs\" \"IMPLEMENTATION_PLAN.md\" \"packages/**/*.{ts,json}\" \"services/**/*.{ts,json}\"",
    "format:check": "prettier --check \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"vitest.config.ts\" \"eslint.config.mjs\" \"IMPLEMENTATION_PLAN.md\" \"packages/**/*.{ts,json}\" \"services/**/*.{ts,json}\"",
    "lint": "eslint .",
    "test": "pnpm --filter @nova/shared build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "verify": "pnpm check:links && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
