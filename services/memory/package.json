{
  "name": "@nova/memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@nova/shared": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
